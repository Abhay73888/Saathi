# --- Core ---
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql://saath:saath@127.0.0.1:5432/saath?schema=public

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379

# --- Auth (generate real random values in production!) ---
JWT_ACCESS_SECRET=dev-access-secret-change-me-min-32-chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-min-32-chars
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=30

# --- Payments: leave PAYMENTS_MOCK=true to use the built-in sandbox provider ---
PAYMENTS_MOCK=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Identity verification: mock provider in dev ---
IDV_MOCK=true
IDV_PROVIDER=mock

# --- Notifications ---
EMAIL_FROM=no-reply@saath.app
SMS_PROVIDER=mock

# --- Platform config seeds ---
PLATFORM_CITY_DEFAULT=Noida
